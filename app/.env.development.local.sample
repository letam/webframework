# Copy to .env.development.local. Vite loads this mode's files; an explicit
# shell VITE_WS_PROXY_TARGET takes precedence. Keep API and session cookies on
# the Vite origin. Vite proxies /auth, /api, and /ws to the backend below.
VITE_SERVER_HOST=
VITE_WS_PROXY_TARGET=http://127.0.0.1:8000

# Show practice navigation only on instances that enable the practice backend.
# Direct room links remain available so invited users can open them.
VITE_PRACTICE_ENABLED=false

# Set true to upload media directly to S3/R2 via presigned URLs; false stores
# uploads through the backend (the local-dev default).
VITE_UPLOAD_FILES_TO_S3=false
# VITE_SENTRY_DSN=

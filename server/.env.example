
DEBUG=False
# Generate one: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=REPLACE_WITH_A_GENERATED_SECRET_KEY

# Database Configuration
DATABASE_URL=sqlite:///db.sqlite3
# Persistent-connection lifetime in seconds, PostgreSQL only (ignored on SQLite).
# DB_CONN_MAX_AGE=60

# Cache sizing (LocMemCache MAX_ENTRIES). The defaults suit a small VM; raise only
# if you point the caches at a shared backend. See the "Caches" note in settings.py.
# CACHE_MAX_ENTRIES=10000
# RATE_LIMIT_CACHE_MAX_ENTRIES=50000

# Storage Configuration
MEDIA_URL=/media/  # URL prefix for serving media files
MEDIA_ROOT=uploads  # Path to store uploaded media files
USE_LOCAL_FILE_STORAGE=False  # Set to True to use local file system storage instead of R2

# Cloudflare R2 Configuration (required if USE_LOCAL_FILE_STORAGE is False)
R2_ACCESS_KEY_ID=your_access_id_here
R2_SECRET_ACCESS_KEY=your_secret_key_here
R2_ACCOUNT_ID=your_account_id_here
R2_BUCKET_NAME=your_bucket_name_here
R2_ENDPOINT_DOMAIN=r2.cloudflarestorage.com
R2_ENDPOINT_DOMAIN_FOR_CSP=*.r2.cloudflarestorage.com

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Backend error monitoring DSN; leave commented/empty to disable Sentry.
# SENTRY_DSN=
# Backend trace sampling rate; defaults to 0.0 so tracing is disabled.
# SENTRY_TRACES_SAMPLE_RATE=0.0
# Frontend Sentry ingest origin for CSP connect-src, e.g. https://o12345.ingest.us.sentry.io.
# SENTRY_FRONTEND_INGEST_FOR_CSP=

# Background tasks default to DEBUG. Set False and run `just worker` to exercise the real queue locally.
# TASKS_IMMEDIATE=False
